# TrustFabric Environment Configuration Example
# CASCADE '26 Theme 4 Problem 4.2: The Black Hole Ledger
# Do NOT store production private keys or credentials in source control.

NODE_ENV=development
PORT=5001

# --- Razorpay Payment Gateway (Server Only) ---
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Ethereum / EVM Testnet Relayer Configuration (Server Only) ---
EVM_CHAIN_MODE=sepolia
EVM_CHAIN_ID=11155111
SEPOLIA_RPC_URL=https://rpc.sepolia.org
SEPOLIA_RELAYER_PRIVATE_KEY=
FIAT_DONATION_ANCHOR_CONTRACT_ADDRESS=0x71C25bf4e37da4b7F2eFe341F21074eAf7096eF4
TRUSTFABRIC_ESCROW_CONTRACT_ADDRESS=0x92B34c67D2B1cE09874a12D3A6F1959728864f71
RELAYER_ADDRESS=0xa0Ee7A142d267C1f36714E4a8F75612F20a79720

# --- PostgreSQL / Supabase Database Persistence (Server Only) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_PROVIDER=local_vault
STORAGE_VAULT_BUCKET=private_evidence

# --- Privacy-Preserving Expense Nullifier Salt ---
NULLIFIER_SALT=TF_EXPENSE_SALT_2026_CASCADE_PS42

# --- Client-Exposed Variables (Vite Frontend Only) ---
# NOTE: Never expose secrets, private keys, or webhook keys with VITE_ prefix.
VITE_RAZORPAY_KEY_ID=
VITE_API_BASE_URL=
