# TrustFabric Environment Configuration Example
# CASCADE '26 Theme 4 Problem 4.2: The Black Hole Ledger
# Do NOT store production private keys or credentials in source control.

NODE_ENV=development
PORT=5001

# --- Razorpay Payment Gateway (Server Only) ---
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Ethereum / EVM Testnet Relayer Configuration (Server Only) ---
EVM_CHAIN_MODE=sepolia
EVM_CHAIN_ID=11155111
SEPOLIA_RPC_URL=https://rpc.sepolia.org
SEPOLIA_RELAYER_PRIVATE_KEY=
FIAT_DONATION_ANCHOR_CONTRACT_ADDRESS=0x71C25bf4e37da4b7F2eFe341F21074eAf7096eF4
TRUSTFABRIC_ESCROW_CONTRACT_ADDRESS=0x92B34c67D2B1cE09874a12D3A6F1959728864f71
RELAYER_ADDRESS=0xa0Ee7A142d267C1f36714E4a8F75612F20a79720

# --- Socket.IO Real-Time Broadcasting (Server Only) ---
SOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# --- PostgreSQL / Supabase Database Persistence (Server Only) ---
DATABASE_URL=postgresql://postgres.example:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.example:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_PROVIDER=local_vault
STORAGE_VAULT_BUCKET=private_evidence

# --- Redis Scaled Broker (Optional / Background Relayer & Outbox Queue) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Privacy-Preserving Expense Nullifier Salt ---
NULLIFIER_SALT=TF_EXPENSE_SALT_2026_CASCADE_PS42

# --- Clerk Authentication Configuration ---
CLERK_PUBLISHABLE_KEY=pk_test_placeholder_for_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_placeholder_for_clerk_secret_key
CLERK_WEBHOOK_SECRET=whsec_placeholder_for_clerk_webhook_signing_secret

# --- Client-Exposed Variables (Vite Frontend Only) ---
# NOTE: Never expose secrets, private keys, or webhook keys with VITE_ prefix.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_for_clerk_publishable_key
VITE_RAZORPAY_KEY_ID=
VITE_API_BASE_URL=

